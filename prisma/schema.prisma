generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/** NSE corporate actions cache (shared across users). */
model CorporateAction {
  id              String   @id @default(uuid())
  symbol          String
  exDate          DateTime
  actionType      String
  subject         String
  ratioNum        Float?
  ratioDen        Float?
  shareMultiplier Float?
  dividendAmount  Float?
  source          String   @default("NSE")
  fetchedAt       DateTime @default(now())

  @@unique([symbol, actionType, subject])
  @@index([symbol, exDate])
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  passwordHash      String
  name              String?
  /**
   * Sessions issued before this instant are rejected. Logout and password
   * change bump it, which is what actually revokes a stolen cookie — clearing
   * the cookie only removes the browser's copy.
   */
  sessionsValidFrom DateTime?
  /**
   * Telegram chat to alert on signal changes. The bot token is app-level
   * (TELEGRAM_BOT_TOKEN); only the destination is per-user. Null disables alerts.
   */
  telegramChatId    String?
  labPositions      LabPosition[]
  scanFilters       ScanFilter[]
  /** JSON: Zerodha holdings export for qty reconciliation */
  holdingsSnapshot  String?
  /** JSON: { fetchedAt, prices: { SYMBOL: ltp }, failed?: string[] } from NSE/Yahoo */
  ltpSnapshot       String?
  assets            Asset[]
  transactions Transaction[]
  importFiles  ImportFile[]
  watchlists   WatchlistItem[]
  pinnedStrategies PinnedStrategy[]
  screenerSignals ScreenerSignal[]
  createdAt    DateTime      @default(now())
}

model PinnedStrategy {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol       String
  strategyName String
  pinnedAt     DateTime @default(now())

  // Signal tracking
  lastSignal   String?  // BUY, SELL, HOLD
  signalDate   DateTime?
  isNewSignal  Boolean  @default(false)
  statsJson    String?  // Cache for winRate, averageReturn, totalTrades, etc.
  lastUpdated  DateTime?
  /**
   * Signal the user was last notified about. Without this a cron running daily
   * re-sends the same alert every run for as long as the signal persists, and
   * an alert you receive every morning stops being an alert.
   */
  lastNotifiedSignal String?

  @@unique([userId, symbol, strategyName])
}

/**
 * A position the user actually took after seeing a signal.
 *
 * Signals alone cannot tell anyone what to do next: the app knew a strategy
 * fired, not that you acted on it, at what price, or in what size. Without that
 * the exit alert has no P&L behind it and every number shown is the backtest's
 * rather than yours — you may well have bought three days later at a worse price.
 */
model LabPosition {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol        String
  /** Strategy that produced the entry signal, so the exit rule stays attached. */
  strategyName  String
  entryPrice    Float
  quantity      Float
  entryDate     DateTime
  /** Optional hard floor, independent of the strategy's own exit condition. */
  stopLossPrice Float?
  exitPrice     Float?
  exitDate      DateTime?
  /** OPEN | CLOSED */
  status        String    @default("OPEN")
  notes         String?

  /**
   * Signal state, tracked per position rather than per pinned strategy.
   *
   * Watching setups you do not own was dropped: a signal only matters once
   * there is money behind it, and BUY opportunities come from scanning, not
   * from a standing list. So the cron walks OPEN positions and answers one
   * question — is it time to sell this?
   */
  lastSignal         String?
  signalDate         DateTime?
  isNewSignal        Boolean   @default(false)
  /** Last signal actually sent, so a persistent SELL is not re-alerted daily. */
  lastNotifiedSignal String?
  statsJson          String?
  lastChecked        DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, symbol])
}

model ImportFile {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  imported  Int
  skipped   Int
  createdAt DateTime @default(now())
}

model Asset {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalKey  String
  symbol        String
  isin          String?
  symbolAliases String        @default("[]")
  name          String
  price         Float         @default(0.0)
  assetClass    String        @default("STOCK")
  benchmarkId   String?
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, canonicalKey])
}

model Transaction {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId            String
  asset              Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type               String   // BUY, SELL, BONUS, SPLIT
  quantity           Float
  price              Float
  splitRatio         Float?   // For SPLIT: new_qty / old_qty (e.g. 2 for 1:2)
  date               DateTime
  exchange           String?
  segment            String?
  series             String?
  auction            Boolean  @default(false)
  tradeId            String?
  orderId            String?
  orderExecutionTime DateTime?
  createdAt          DateTime @default(now())

  @@unique([userId, tradeId])
}

model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  createdAt DateTime @default(now())

  @@unique([userId, symbol])
}

model ScreenerSignal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  type        String   // BUY or SELL
  rule        String   // e.g. "RSI_OVERSOLD", "SMA_GOLDEN_CROSS"
  price       Float
  date        DateTime
  description String
  createdAt   DateTime @default(now())

  @@index([userId, symbol, date])
}

/**
 * Index membership over time, synced from NSE.
 *
 * Stored as PERIODS rather than a snapshot per sync: one row per (index, symbol,
 * spell), with firstSeen when it appeared and lastSeen from the most recent sync
 * that still listed it. A symbol dropped from the index keeps its row with
 * active=false, so its membership window survives.
 *
 * This is what eventually kills the survivorship bias. Today the app can only
 * scan CURRENT members over all history — testing companies already known to
 * have survived. Once a couple of years of these rows exist, a backtest can ask
 * "who was actually in the Nifty 50 in March 2027" and get an honest answer.
 * A symbol can rejoin an index, hence the spell-based unique key.
 */
model IndexMembership {
  id        String   @id @default(uuid())
  indexId   String   // nifty50 | nifty100 | midcap150 | smallcap250 | nifty500
  symbol    String   // Yahoo-style, e.g. RELIANCE.NS
  company   String?
  industry  String?
  firstSeen DateTime
  lastSeen  DateTime
  active    Boolean  @default(true)

  @@unique([indexId, symbol, firstSeen])
  @@index([indexId, active])
  @@index([indexId, lastSeen])
}

/** Last run per index, so a failed sync is visible instead of silent. */
model IndexSyncLog {
  indexId   String   @id
  syncedAt  DateTime
  count     Int
  added     Int      @default(0)
  removed   Int      @default(0)
  ok        Boolean  @default(true)
  error     String?
}

/**
 * A named set of scan filters.
 *
 * Six numbers retyped before every scan is friction that makes people scan with
 * whatever was left over from last time. Saved, named and editable instead.
 *
 * Fitted and out-of-sample floors are stored separately because they answer
 * different questions: fitted is what the strategy scored where it was chosen,
 * out-of-sample is what it did on data it never saw.
 */
model ScanFilter {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  /** Fitted (selection) window. 0 disables each one. */
  minWinRate  Float @default(0)
  minTrades   Int   @default(0)
  maxDrawdown Float @default(0)

  /** Held-back window. 0 disables each one. */
  oosMinWinRate  Float @default(0)
  oosMinTrades   Int   @default(0)
  oosMaxDrawdown Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model ScanCache {
  id        String   @id @default(uuid())
  symbol    String
  dateKey   String   // "YYYY-MM-DD" representing the date the scan was run
  results   String   // JSON string of the BatchOptimizerResult array
  createdAt DateTime @default(now())

  @@unique([symbol, dateKey])
}
