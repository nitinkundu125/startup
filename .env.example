DATABASE_URL="file:./dev.db"

# Session signing key. REQUIRED in production — the app now refuses to sign
# sessions without it rather than falling back to a key committed in the source.
# Generate with:  openssl rand -base64 48
AUTH_SECRET="use-a-long-random-string-in-production"

# Shared secret for scheduler-invoked endpoints:
#   POST /api/cron/run-pinned
#   POST /api/cron/run-screener
# Send as `Authorization: Bearer <secret>` or `X-Cron-Secret: <secret>`.
# Leave unset to disable cron access entirely (browser sessions still work).
CRON_SECRET=""

# Backtest transaction cost, one way, as a FRACTION of trade value.
# 0.0015 = 15 bps per leg (~30 bps round trip) - the default, an estimate for
# Indian delivery equity with a discount broker. Set this to YOUR broker rate:
# it lands hardest on the high-frequency, small-edge strategies the optimizer
# prefers, so a wrong value quietly changes which strategies look good.
BACKTEST_ONE_WAY_COST_PCT="0.0015"

# Years of history to backtest. 0 (the default) uses the stock's ENTIRE
# history back to its IPO. Set a positive number to bound the window: the scan
# universe is TODAY's index membership, so the further back it reaches the more
# survivorship bias compounds.
BACKTEST_LOOKBACK_YEARS="0"

# Mark the session cookie Secure. Leave unset to follow NODE_ENV (the safe
# default). Set false ONLY when serving over plain HTTP on a trusted private
# network - a Secure cookie over HTTP is dropped by the browser, so login
# returns 200 and the user stays logged out with nothing in the logs.
# false means session cookies travel in cleartext. Put TLS in front before
# exposing the app beyond a private network.
COOKIE_SECURE="false"

# Telegram alerts for pinned-strategy signal changes. Leave unset to disable.
# 1. Message @BotFather, /newbot, copy the token here
# 2. Message your bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id
# 3. Save that chat id on your user row (User.telegramChatId)
TELEGRAM_BOT_TOKEN=""
