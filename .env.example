DATABASE_URL="file:./dev.db"

# Session signing key. REQUIRED in production — the app now refuses to sign
# sessions without it rather than falling back to a key committed in the source.
# Generate with:  openssl rand -base64 48
AUTH_SECRET="use-a-long-random-string-in-production"

# Shared secret for scheduler-invoked endpoints:
#   POST /api/cron/run-pinned
#   POST /api/cron/run-screener
# Send as `Authorization: Bearer <secret>` or `X-Cron-Secret: <secret>`.
# Leave unset to disable cron access entirely (browser sessions still work).
CRON_SECRET=""
